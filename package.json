{
  "name": "hostler",
  "version": "0.1.0",
  "description": "Hostler — SSH control center for native coding agents (Claude Code, Codex, OpenCode)",
  "private": true,
  "main": "dist/electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n server,ui,electron \"npm:dev:server\" \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:web": "concurrently -k -n server,ui \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "cross-env HOSTLER_DEV=1 tsx watch server/index.ts",
    "dev:ui": "vite --config vite.config.ts",
    "dev:electron": "wait-on http://127.0.0.1:5173 && npm run build:electron && cross-env HOSTLER_DEV_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run build:server && npm run build:electron && npm run build:ui",
    "build:server": "tsc -p tsconfig.server.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:ui": "vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "start": "bin/hostler",
    "start:web": "node dist/server/index.js",
    "test:helper": "python3 helper/test_helper.py",
    "test:e2e": "node test/e2e.mjs",
    "test": "npm run typecheck && npm run test:introspect && npm run test:helper && npm run build:server && npm run test:e2e && npm run test:auth",
    "web": "bin/hostler --web",
    "test:auth": "node test/auth.mjs",
    "demo": "cross-env HOSTLER_DEMO=1 HOSTLER_OPEN=1 node dist/server/index.js",
    "test:introspect": "python3 helper/test_introspect.py",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "license": "MIT",
  "homepage": "https://github.com/zhehanli66/hostler#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhehanli66/hostler.git"
  },
  "bugs": {
    "url": "https://github.com/zhehanli66/hostler/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ssh",
    "claude-code",
    "codex",
    "opencode",
    "coding-agents",
    "control-center",
    "electron",
    "pty",
    "jetson"
  ],
  "build": {
    "appId": "dev.hostler.app",
    "productName": "Hostler",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "helper",
        "to": "helper",
        "filter": [
          "hostler_helper.py"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "SSH control center for native coding agents",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    }
  },
  "desktopName": "hostler",
  "author": "Hostler contributors"
}
